<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ nginx_site_title }}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 640px; margin: 4rem auto; padding: 0 1rem; }
    code { background: #f2f2f2; padding: 2px 6px; border-radius: 4px; }
  </style>
</head>
<body>
  <h1>{{ nginx_site_title }}</h1>
  <ul>
    <li>Hostname: <code>{{ inventory_hostname }}</code></li>
    <li>IP: <code>{{ ansible_host }}</code></li>
    <li>OS: <code>{{ ansible_distribution }} {{ ansible_distribution_version }}</code></li>
    <li>Provisioned by: <code>OpenTofu (bpg/proxmox)</code></li>
    <li>Configured by: <code>Ansible</code></li>
  </ul>
</body>
</html>
