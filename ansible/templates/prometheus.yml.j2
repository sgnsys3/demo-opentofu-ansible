# Managed by Ansible (monitoring.yml) - targets are generated from the inventory
global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels: { instance: "{{ inventory_hostname }}" }

  # Saturation: CPU, memory, disk, network of every VM
  - job_name: node
    static_configs:
{% for host in groups['all'] %}
      - targets: ["{{ hostvars[host].ansible_host }}:9100"]
        labels: { instance: "{{ host }}" }
{% endfor %}

  # Traffic: connections and requests from nginx stub_status
  - job_name: nginx
    static_configs:
{% for host in groups['web'] %}
      - targets: ["{{ hostvars[host].ansible_host }}:9113"]
        labels: { instance: "{{ host }}" }
{% endfor %}

  # Latency, traffic and errors from the nginx access log
  - job_name: nginxlog
    static_configs:
{% for host in groups['web'] %}
      - targets: ["{{ hostvars[host].ansible_host }}:4040"]
        labels: { instance: "{{ host }}" }
{% endfor %}
