{
  "uid": "golden-signals",
  "title": "Nginx Golden Signals",
  "tags": [
    "sre",
    "nginx",
    "golden-signals"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### The four golden signals of nginx\n**Latency** (how long requests take) \u00b7 **Traffic** (how many requests) \u00b7 **Errors** (how many fail) \u00b7 **Saturation** (how full the servers are)  \n**SLO:** 99% of requests succeed (error budget = 1%) and p95 latency stays under 500 ms. Generate traffic from your laptop: `make load`, `make load MODE=errors`, `make load MODE=slow`"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (SLI, 1h)",
      "description": "Share of requests that did not return 5xx in the last hour. SLO: 99%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(rate(nginx_http_response_count_total{status=~\"5..\"}[1h])) / sum(rate(nginx_http_response_count_total[1h])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error budget left (1h)",
      "description": "The SLO allows 1% of requests to fail. 100% = nothing used yet; 0% = budget gone, the SLO is broken.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(1 - ((sum(rate(nginx_http_response_count_total{status=~\"5..\"}[1h])) / sum(rate(nginx_http_response_count_total[1h]))) / 0.01), 0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency (5m)",
      "description": "95% of requests finished faster than this. SLO: under 500 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nginx_http_response_time_seconds_hist_bucket[5m])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
