# OpenTofu
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Generated by tofu (02-instance)
ansible/inventory.ini

# Local tooling (make setup)
.ssh/
# Generated passwords (e.g. Grafana admin), created by Ansible
.secrets/
.venv/
bin/

# Claude Code local working files
.claude/

# Python bytecode
__pycache__/

# Windows "downloaded from the internet" marker files (WSL)
*:Zone.Identifier
