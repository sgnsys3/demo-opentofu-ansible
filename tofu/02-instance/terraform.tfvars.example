proxmox_endpoint  = "https://192.168.1.10:8006/"
proxmox_api_token = "tofu@pve!tofu=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_insecure  = true

node_name          = "pve"
template_node_name = "pve"
template_vm_id     = 9000
vm_datastore_id    = "local-lvm"
bridge             = "vmbr0"

instances = {
  "web-01" = { vm_id = 201, ip_cidr = "192.168.1.101/24" }
  # "web-02" = { vm_id = 202, ip_cidr = "192.168.1.102/24" }
}

gateway     = "192.168.1.1"
dns_servers = ["1.1.1.1", "8.8.8.8"]

vm_user              = "ubuntu"
ssh_public_key_path  = "../../.ssh/id_ed25519.pub"
ssh_private_key_path = "../../.ssh/id_ed25519"
